3986 0 obj
  << /ActualText (Je bent begonnen met het blok Ontwerpen voor Gedragsverandering \056 Schrijf een korte reflectie over je leerdoel\050en\051\056\n\240\nBeschrijf hieronder in maximaal 100 woorden\072\240\nWat is je leerdoel voor dit blok\077\nWat verwacht je van het blok\077\nWaar wil je je het meest in ontwikkelen\077\n\n\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\055\nMijn leerdoel voor dit blok is vooral expirimenteren en verbeteren\056 Dit blok wil ik ervoor zorgen dat veel meer ga testen\054 onderzoeken en zo voortgang maken\056 Ik wil vooral veel meer ook thuis doen en meer buiten schooltijden aan de slag gaan\056 Feedback vragen en krijgen heb ik altijd lastig gevonden\054 omdat ik vaak teveel twijfel of het echt nodig is of dat ik feedback ga vragen puur omdat het feedback vragen is\056\056\056 \050\050In dit blok verwacht ik dat we proffesioneler aan de slag gaan en meer als een team gaan werken\056 Ik verwacht ook dat we de meeste dingen zelf gaan moeten en uitvogelen\056\050\050In alle tools eigenlijk die we gaan gebruiken en hebben gebruikt om tot een eindresultaat te komen\056 Ik heb nog niet echt een plan hoe ik dat ga doen\056 Ik weet wat wel dat ik elke dag serieus ga meedoen\054 proberen bij de les te blijven en ervoor zorgen dat ik niet achterloop\056)
     /K [ 54 ]
     /P 3987 0 R
     /Pg 3882 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

3987 0 obj
  << /K [ 3986 0 R ]
     /P 5988 0 R
     /S /P
     /Pg 3882 0 R
     /Type /StructElem
  >>
endobj

